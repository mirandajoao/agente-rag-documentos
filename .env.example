# Copie para .env e preencha. NUNCA faça commit do arquivo .env.
OPENAI_API_KEY=sk-...

# Modelos (padrões econômicos)
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Fatiamento / recuperação (opcionais)
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=200
# RETRIEVER_TOP_K=4
# RETRIEVER_MAX_DISTANCE=0.75
# BM25_TOP_K=3

# Custo exibido em reais e URL do QR code (opcionais)
# USD_BRL=5.40
# PUBLIC_URL=https://seu-app.up.railway.app

# Blindagem (opcionais)
# MAX_QUESTION_CHARS=1000
# RATE_LIMIT_PER_MINUTE=15            # por navegador
# RATE_LIMIT_IP_PER_MINUTE=300        # teto por IP (o laboratório inteiro sai pelo mesmo IP)

# Upload de documentos (opcionais)
# MAX_UPLOAD_MB=15
# MAX_UPLOAD_PAGINAS=200
# MAX_DOCUMENTOS_POR_ESPACO=5
# RATE_LIMIT_UPLOAD_PER_MINUTE=6      # por navegador
# RATE_LIMIT_UPLOAD_IP_PER_MINUTE=90  # teto por IP
# INCLUIR_DOCUMENTOS_EXEMPLO=true

# Limite diário de gasto da demonstração (0 desliga)
# ORCAMENTO_DIARIO_USD=1.0
# FUSO_ORCAMENTO=America/Belem

# Provedor de IA: openai (padrão) ou gemini (plano gratuito do Google)
# PROVEDOR_IA=gemini
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Oficina (modo aula) ---
# MINISTRANTE_SENHA=uma-senha-forte   # Modo ministrante no app + moderação do /turma (sem acentos; PAINEL_SENHA também vale)
# MODELOS_COMPARACAO=gpt-4o-mini,gpt-4o
# PAINEL_TURMA=true
# STREAM_TOKENS=true
# DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require   # opcional: guarda uso, painel e controles (Neon)
# DOCUMENTOS_RETENCAO_DIAS=30   # com DATABASE_URL: por quantos dias os documentos enviados ficam no banco
# MEMORIA_RETENCAO_DIAS=7       # com DATABASE_URL: conversas paradas há mais tempo são apagadas

# --- Qualidade e monitoramento ---
# RERANK=llm                    # o modelo dá nota aos trechos e descarta os que não ajudam (off desliga)
# RERANK_NOTA_MINIMA=3          # nota mínima (0 a 10) para o trecho chegar ao agente
# SENTRY_DSN=                   # opcional: erros do servidor no Sentry (sem dados do usuário)
